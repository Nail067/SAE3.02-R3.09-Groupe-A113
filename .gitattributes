# Fins de ligne : les scripts exécutés sous Linux doivent rester en LF, même si le projet est édité sous Windows
* text=auto
*.sh        text eol=lf
*.service   text eol=lf
*.sql       text eol=lf
*.py        text eol=lf
*.md        text eol=lf
*.example   text eol=lf
interfaces.* text eol=lf
*.png binary
*.pdf binary
*.bat      text eol=crlf

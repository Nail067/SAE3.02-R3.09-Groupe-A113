# /etc/carrefour/serveur.env  (droits 640, propriétaire root:carrefour) – NE JAMAIS le mettre sur GitHub
DB_HOST=192.168.56.102
DB_PORT=3306
DB_USER=carrefour
DB_PASSWORD=ChangezMoi
DB_NAME=carrefour
# Jeton partagé avec les postes IHM (laisser vide pour désactiver l'authentification)
CARREFOUR_TOKEN=
SERVER_HOST=0.0.0.0
SERVER_PORT=5050
LOG_LEVEL=INFO
# Utilisé uniquement si MariaDB est injoignable (repli de secours)
SQLITE_PATH=/var/lib/carrefour/carrefour.db
